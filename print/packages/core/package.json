{
  "name": "@xihan-print/core",
  "type": "module",
  "version": "1.0.0-rc.1",
  "description": "XiHan Print Designer core — template schema, validation and edit commands; pure TypeScript, no DOM.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://github.com/XiHanFun/XiHan.PrintDesigner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.PrintDesigner.git",
    "directory": "print/packages/core"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.PrintDesigner/issues"
  },
  "keywords": [
    "print",
    "print-designer",
    "print-template",
    "web-components",
    "xihanfun"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@xihan-ui/core": "^5.0.0",
    "@xihan-ui/designer-kit": "^5.0.0",
    "@xihan-ui/expression": "^5.0.0",
    "@xihan-ui/headless": "^5.0.0",
    "@xihan-ui/viz": "^5.0.0"
  },
  "devDependencies": {
    "@xihan-ui/core": "catalog:",
    "@xihan-ui/designer-kit": "catalog:",
    "@xihan-ui/expression": "catalog:",
    "@xihan-ui/headless": "catalog:",
    "@xihan-ui/viz": "catalog:"
  }
}
