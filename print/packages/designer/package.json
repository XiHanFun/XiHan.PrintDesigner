{
  "name": "@xihan-print/designer",
  "type": "module",
  "version": "0.0.0",
  "description": "XiHan Print Designer — a visual print template designer delivered as Web Components.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://github.com/XiHanFun/XiHan.PrintDesigner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.PrintDesigner.git",
    "directory": "print/packages/designer"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.PrintDesigner/issues"
  },
  "keywords": [
    "print",
    "print-designer",
    "print-template",
    "web-components",
    "xihanfun"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./style.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "style.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@xihan-print/core": "workspace:^",
    "@xihan-print/runtime": "workspace:^",
    "@xihan-ui/core": "catalog:",
    "@xihan-ui/designer-kit": "catalog:",
    "@xihan-ui/expression": "catalog:",
    "@xihan-ui/pointer": "catalog:",
    "@xihan-ui/viz": "catalog:",
    "@xihan-ui/web-components": "catalog:"
  },
  "devDependencies": {
    "jsdom": "catalog:"
  }
}
