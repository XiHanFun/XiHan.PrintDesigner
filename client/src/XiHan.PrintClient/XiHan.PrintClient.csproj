<Project Sdk="Microsoft.NET.Sdk">

  <!-- 托盘程序：组装 Core 与 Windows 两层，提供托盘、授权窗口与设置窗口 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>XiHanPrint</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- 发布：自包含、ReadyToRun、不裁剪，不带 XML 文档 -->
  <PropertyGroup>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XiHan.PrintClient.Core\XiHan.PrintClient.Core.csproj" />
    <ProjectReference Include="..\XiHan.PrintClient.Windows\XiHan.PrintClient.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdatePublisher" Value="$(XiHanUpdatePublisher)" />
  </ItemGroup>

</Project>
